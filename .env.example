# Copy to .env — docker compose reads it automatically.

# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# Host ports published by docker compose
API_PORT=8080
WEB_PORT=5173

# API (container/process port)
PORT=8080
# Leave empty to run the API without a database.
# Host dev against `pnpm db:up`: postgres://app:app@localhost:5432/app?sslmode=disable
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173
